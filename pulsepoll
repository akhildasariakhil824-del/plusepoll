#!/usr/bin/env bash
# ==============================================================================
# PulsePoll — NextGen Real-Time Live Polling Platform
# Turnkey Terminal Launcher & CLI Suite
# ==============================================================================

# ANSI Color Codes
CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
MAGENTA='\033[0;35m'
BLUE='\033[0;34m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m' # No Color

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BACKEND_DIR="$ROOT_DIR/backend"
FRONTEND_DIR="$ROOT_DIR/frontend"

# Banner
print_banner() {
    printf "${CYAN}${BOLD}"
    cat << "EOF"
  ____        _            ____       _ _ 
 |  _ \ _   _| |___  ___  |  _ \ ___ | | |
 | |_) | | | | / __|/ _ \ | |_) / _ \| | |
 |  __/| |_| | \__ \  __/ |  __/ (_) | | |
 |_|    \__,_|_|___/\___| |_|   \___/|_|_|
EOF
    printf "${NC}${YELLOW}  ⚡ Real-Time Live Polling Engine (Go + React + Redis + MongoDB)${NC}\n\n"
}

# Preflight environment check
check_prerequisites() {
    printf "${BOLD}Performing environment checks...${NC}\n"

    # Go check
    if command -v go >/dev/null 2>&1; then
        GO_VER=$(go version | awk '{print $3}')
        printf "  ${GREEN}✔${NC} Go detected: ${BOLD}%s${NC}\n" "$GO_VER"
    else
        printf "  ${RED}✖ Go is not installed. Please install Go 1.22+ to build backend.${NC}\n"
    fi

    # Node check
    if command -v node >/dev/null 2>&1; then
        NODE_VER=$(node -v)
        printf "  ${GREEN}✔${NC} Node.js detected: ${BOLD}%s${NC}\n" "$NODE_VER"
    else
        printf "  ${RED}✖ Node.js is not installed. Please install Node.js 18+ for frontend.${NC}\n"
    fi

    # Redis check
    if command -v redis-cli >/dev/null 2>&1 && redis-cli ping >/dev/null 2>&1; then
        printf "  ${GREEN}✔${NC} Redis running on localhost:6379 (${BOLD}Real-Time Engine Active${NC})\n"
    elif command -v redis-server >/dev/null 2>&1; then
        printf "  ${YELLOW}⚡ Starting local Redis daemon...${NC}\n"
        redis-server --daemonize yes >/dev/null 2>&1 || true
        if redis-cli ping >/dev/null 2>&1; then
            printf "  ${GREEN}✔${NC} Redis successfully started on localhost:6379\n"
        else
            printf "  ${YELLOW}⚠️ Redis could not be started in background. Running with resilient In-Memory Engine!${NC}\n"
        fi
    else
        printf "  ${YELLOW}⚠️ Redis not installed locally. Backend will use resilient In-Memory Engine.${NC}\n"
    fi

    # MongoDB check
    if command -v mongosh >/dev/null 2>&1 && mongosh --eval "db.adminCommand('ping')" --quiet >/dev/null 2>&1; then
        printf "  ${GREEN}✔${NC} MongoDB running on localhost:27017 (${BOLD}Persistent Audit DB Active${NC})\n"
    else
        printf "  ${YELLOW}ℹ️ MongoDB daemon not active locally. Backend will use durable In-Memory DataStore.${NC}\n"
    fi
    printf "\n"
}

# Compile binaries if needed
ensure_binaries() {
    if [ ! -f "$ROOT_DIR/pulsepoll-server" ]; then
        printf "${CYAN}Building Go backend binary...${NC}\n"
        (cd "$BACKEND_DIR" && go build -buildvcs=false -o "$ROOT_DIR/pulsepoll-server" .)
    fi

    if [ ! -f "$ROOT_DIR/pulsepoll-cli" ]; then
        printf "${CYAN}Building Terminal CLI binary...${NC}\n"
        (cd "$BACKEND_DIR" && go build -buildvcs=false -o "$ROOT_DIR/pulsepoll-cli" ./cmd/cli)
    fi

    if [ ! -d "$FRONTEND_DIR/node_modules" ]; then
        printf "${CYAN}Installing frontend npm dependencies...${NC}\n"
        (cd "$FRONTEND_DIR" && npm install)
    fi
}

# Start full stack directly through terminal
start_all() {
    print_banner
    check_prerequisites
    ensure_binaries

    BACKEND_PID=""
    FRONTEND_PID=""

    cleanup() {
        printf "\n\n${YELLOW}Shutting down PulsePoll services...${NC}\n"
        if [ -n "$BACKEND_PID" ]; then
            kill "$BACKEND_PID" >/dev/null 2>&1 || true
        fi
        if [ -n "$FRONTEND_PID" ]; then
            kill "$FRONTEND_PID" >/dev/null 2>&1 || true
        fi
        printf "${GREEN}All services stopped cleanly. Goodbye!${NC}\n"
        exit 0
    }

    trap cleanup SIGINT SIGTERM EXIT

    printf "${BOLD}${CYAN}🚀 Launching PulsePoll Services...${NC}\n"
    printf "${DIM}------------------------------------------------------------${NC}\n"

    # 1. Start Go Backend
    printf "${GREEN}▶ Starting Go (Gin) Backend on :8080...${NC}\n"
    (cd "$BACKEND_DIR" && "$ROOT_DIR/pulsepoll-server") &
    BACKEND_PID=$!

    # Wait for backend health
    printf "Waiting for backend health check..."
    for i in {1..30}; do
        if curl -s http://localhost:8080/api/health >/dev/null 2>&1; then
            printf " ${GREEN}✔ Ready!${NC}\n"
            break
        fi
        sleep 0.5
        printf "."
    done

    # 2. Start React Frontend
    printf "${GREEN}▶ Starting React (Vite) Frontend on :5173...${NC}\n"
    (cd "$FRONTEND_DIR" && npm run dev) &
    FRONTEND_PID=$!

    sleep 2
    printf "\n"
    printf "${BOLD}============================================================${NC}\n"
    printf "${GREEN}${BOLD}   ⚡ PULSEPOLL IS RUNNING DIRECTLY FROM TERMINAL!${NC}\n"
    printf "${BOLD}============================================================${NC}\n"
    printf "  🌐 ${BOLD}React Web App:${NC}      ${CYAN}http://localhost:5173${NC}\n"
    printf "  ⚡ ${BOLD}Go Backend API:${NC}     ${CYAN}http://localhost:8080${NC}\n"
    printf "  🏥 ${BOLD}Health Endpoint:${NC}    ${CYAN}http://localhost:8080/api/health${NC}\n"
    printf "  🔑 ${BOLD}Demo Account:${NC}       ${YELLOW}demo@pulsepoll.io${NC} / ${YELLOW}demopass123${NC}\n"
    printf "\n"
    printf "  💻 ${BOLD}Terminal Live Tools (in another terminal tab):${NC}\n"
    printf "     • Interactive CLI:   ${YELLOW}./pulsepoll cli${NC}\n"
    printf "     • Watch Bar Chart:   ${YELLOW}./pulsepoll watch <poll-id>${NC}\n"
    printf "     • Simulate Votes:    ${YELLOW}./pulsepoll simulate <poll-id> 50${NC}\n"
    printf "------------------------------------------------------------\n"
    printf "${DIM}Press Ctrl+C at any time to gracefully stop all services.${NC}\n\n"

    # Wait for background processes
    wait "$BACKEND_PID" "$FRONTEND_PID"
}

# Run CLI
run_cli() {
    ensure_binaries
    "$ROOT_DIR/pulsepoll-cli" "$@"
}

# Run Docker
run_docker() {
    print_banner
    printf "${CYAN}${BOLD}🐳 Booting full stack in Docker Compose (Mongo + Redis + Go + React)...${NC}\n"
    docker compose up --build
}

# Run Tests
run_tests() {
    print_banner
    printf "${BOLD}🧪 Running PulsePoll Test Suite...${NC}\n\n"

    printf "${CYAN}1. Testing Go Backend Compilation...${NC}\n"
    (cd "$BACKEND_DIR" && go vet ./... && go build -buildvcs=false -o /dev/null .)
    printf "${GREEN}✔ Backend compilation & vet passed!${NC}\n\n"

    printf "${CYAN}2. Testing React Frontend Build...${NC}\n"
    (cd "$FRONTEND_DIR" && npm run build)
    printf "${GREEN}✔ Frontend production build passed!${NC}\n\n"

    printf "${CYAN}3. Testing PulsePoll Terminal CLI...${NC}\n"
    ensure_binaries
    "$ROOT_DIR/pulsepoll-cli" help >/dev/null
    printf "${GREEN}✔ Terminal CLI test passed!${NC}\n\n"

    printf "${GREEN}${BOLD}🎉 ALL TESTS PASSED! Project is production ready.${NC}\n"
}

# Interactive root menu
interactive_menu() {
    print_banner
    check_prerequisites
    printf "${BOLD}Choose an action:${NC}\n"
    printf "  [${GREEN}1${NC}] 🚀 Start Full Stack (Go Backend + React Frontend)\n"
    printf "  [${GREEN}2${NC}] 💻 Open Terminal Interactive CLI (Create, Vote, Watch)\n"
    printf "  [${GREEN}3${NC}] ⚡ Watch Live Stream Bar Chart (Real-time WebSocket Terminal Dashboard)\n"
    printf "  [${GREEN}4${NC}] 🚀 Run Concurrent Vote Simulation (Load Test Redis)\n"
    printf "  [${GREEN}5${NC}] 🐳 Run with Docker Compose (Multi-Container Stack)\n"
    printf "  [${GREEN}6${NC}] 🧪 Run System Tests & Build Verification\n"
    printf "  [${RED}0${NC}] 🚪 Exit\n\n"
    printf "${BOLD}Enter choice (0-6): ${NC}"
    read -r choice

    case "$choice" in
        1) start_all ;;
        2) run_cli ;;
        3) 
            printf "Enter Poll ID to watch: "
            read -r pid
            run_cli watch "$pid"
            ;;
        4)
            printf "Enter Poll ID to simulate: "
            read -r pid
            printf "Number of votes (default 50): "
            read -r count
            count=${count:-50}
            run_cli simulate "$pid" "$count"
            ;;
        5) run_docker ;;
        6) run_tests ;;
        0|exit|quit) exit 0 ;;
        *) printf "${RED}Invalid choice.${NC}\n"; exit 1 ;;
    esac
}

# Main entrypoint
CMD="${1:-}"

case "$CMD" in
    start|run|dev)
        start_all
        ;;
    cli|interactive)
        shift || true
        run_cli "$@"
        ;;
    list|create|vote|watch|simulate)
        run_cli "$@"
        ;;
    docker)
        run_docker
        ;;
    test)
        run_tests
        ;;
    build)
        print_banner
        ensure_binaries
        (cd "$FRONTEND_DIR" && npm run build)
        printf "\n${GREEN}${BOLD}✔ Build completed successfully!${NC}\n"
        ;;
    help|--help|-h)
        print_banner
        printf "${BOLD}Usage:${NC} ./pulsepoll [command]\n\n"
        printf "${BOLD}Commands:${NC}\n"
        printf "  ${GREEN}./pulsepoll start${NC}             Start Go backend & React frontend directly in terminal\n"
        printf "  ${GREEN}./pulsepoll cli${NC}               Launch interactive Terminal Polling app\n"
        printf "  ${GREEN}./pulsepoll list${NC}              List all active polls in terminal\n"
        printf "  ${GREEN}./pulsepoll create${NC}            Interactively create a poll from terminal\n"
        printf "  ${GREEN}./pulsepoll vote <id>${NC}         Cast vote from terminal\n"
        printf "  ${GREEN}./pulsepoll watch <id>${NC}        Watch real-time WebSocket live bar chart in terminal\n"
        printf "  ${GREEN}./pulsepoll simulate <id> [n]${NC} Run live traffic simulator against Redis\n"
        printf "  ${GREEN}./pulsepoll docker${NC}            Boot with Docker Compose\n"
        printf "  ${GREEN}./pulsepoll test${NC}              Run compilation & build checks\n"
        printf "  ${GREEN}./pulsepoll build${NC}             Build Go binaries and React frontend\n\n"
        ;;
    "")
        interactive_menu
        ;;
    *)
        printf "${RED}Unknown command: %s${NC}\n" "$CMD"
        printf "Run ${YELLOW}./pulsepoll help${NC} for available commands.\n"
        exit 1
        ;;
esac
